<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme of the Android window while the process starts. Delve is dark only,
         so light and dark mode look the same. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme of the window behind the Flutter UI (V2 embedding). -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
